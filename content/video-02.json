  "captions": [
    {
      "text": "من فجوة تعليمية…",
      "start": 1.23,
      "end": 2.93
    },
    {
      "text": "إلى إنجاز ملموس.",
      "start": 3.48,
      "end": 5.15
    },
    {
      "text": "منصة الدعم التعليمي المكثف",
      "start": 6.54,
      "end": 9.0
    },
    {
      "text": "هي رحلة رقمية متكاملة،",
      "start": 9.0,
      "end": 11.39
    },
    {
      "text": "تبدأ بتشخيص مستوى الطالبات،",
      "start": 11.8,
      "end": 14.45
    },
    {
      "text": "ثم بناء الخطة العلاجية،",
      "start": 14.45,
      "end": 16.61
    },
    {
      "text": "وتنفيذ التدخلات المناسبة،",
      "start": 16.61,
      "end": 19.06
    },
    {
      "text": "ومتابعة التقدم خطوة بخطوة.",
      "start": 19.06,
      "end": 21.76
    },
    {
      "text": "من خلال الشواهد، والتقارير،",
      "start": 22.23,
      "end": 24.86
    },
    {
      "text": "ونتائج القياس القبلي والبعدي،",
      "start": 24.86,
      "end": 27.7
    },
    {
      "text": "تتحول الجهود التعليمية",
      "start": 27.7,
      "end": 29.84
    },
    {
      "text": "إلى أثر واضح يمكن رصده وتحليله.",
      "start": 29.84,
      "end": 33.05
    },
    {
      "text": "هنا لا يُقاس العمل بعدد المحاولات فقط،",
      "start": 33.69,
      "end": 37.18
    },
    {
      "text": "بل بمقدار التحسن الحقيقي،",
      "start": 37.64,
      "end": 39.87
    },
    {
      "text": "فرديًا وجماعيًا.",
      "start": 40.33,
      "end": 42.23
    },
    {
      "text": "منصة الدعم التعليمي المكثف…",
      "start": 43.78,
      "end": 46.08
    },
    {
      "text": "نرصد التقدم، لنصنع الأثر.",
      "start": 46.71,
      "end": 49.63
    }
  ]
}