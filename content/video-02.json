  "captions": [
    {"text": "من فجوة تعليمية…",                    "start": 1.2,  "end": 3.8},
    {"text": "إلى إنجاز ملموس.",                    "start": 3.8,  "end": 6.4},
    {"text": "منصة الدعم التعليمي المكثف",           "start": 8.2,  "end": 11.4},
    {"text": "هي رحلة رقمية متكاملة،",              "start": 11.4, "end": 14.0},
    {"text": "تبدأ بتشخيص مستوى الطالبات،",          "start": 14.0, "end": 16.8},
    {"text": "ثم بناء الخطة العلاجية،",             "start": 16.8, "end": 19.2},
    {"text": "وتنفيذ التدخلات المناسبة،",            "start": 19.2, "end": 21.8},
    {"text": "ومتابعة التقدم خطوة بخطوة.",           "start": 21.8, "end": 24.6},
    {"text": "من خلال الشواهد، والتقارير،",          "start": 25.6, "end": 28.8},
    {"text": "ونتائج القياس القبلي والبعدي،",        "start": 28.8, "end": 32.2},
    {"text": "تتحول الجهود التعليمية",               "start": 32.2, "end": 34.8},
    {"text": "إلى أثر واضح يمكن رصده وتحليله.",      "start": 34.8, "end": 38.2},
    {"text": "هنا لا يُقاس العمل بعدد المحاولات فقط،", "start": 39.2, "end": 42.6},
    {"text": "بل بمقدار التحسن الحقيقي،",            "start": 42.6, "end": 44.6},
    {"text": "فرديًا وجماعيًا.",                     "start": 44.6, "end": 46.0},
    {"text": "منصة الدعم التعليمي المكثف…",          "start": 47.0, "end": 49.0},
    {"text": "نرصد التقدم، لنصنع الأثر.",            "start": 49.0, "end": 50.8}
  ]
}
